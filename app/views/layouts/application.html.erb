<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Billetto Events" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Billetto Events">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Clerk UI bundle must load before ClerkJS. %>
    <script
      defer
      crossorigin="anonymous"
      src="<%= ENV.fetch('CLERK_FRONTEND_API') %>/npm/@clerk/ui@1/dist/ui.browser.js"
      type="text/javascript">
    </script>

    <script
      defer
      crossorigin="anonymous"
      data-clerk-publishable-key="<%= ENV.fetch('CLERK_PUBLISHABLE_KEY') %>"
      src="<%= ENV.fetch('CLERK_FRONTEND_API') %>/npm/@clerk/clerk-js@6/dist/clerk.browser.js"
      type="text/javascript">
    </script>
  </head>

  <body
    class="min-h-screen bg-gray-50 text-gray-900 antialiased flex flex-col"
    data-controller="clerk"
  >
    <header class="bg-white border-b border-gray-200">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <%= link_to root_path, class: "text-2xl font-bold tracking-tight text-indigo-600" do %>
          Billetto<span class="text-gray-900">.</span>
        <% end %>

        <div class="flex items-center gap-5 text-sm font-medium">
          <%= link_to "Events", root_path, class: "text-gray-600 hover:text-indigo-600 transition" %>

          <div id="clerk-auth-container">
            <div
              id="clerk-signed-out"
              class="hidden"
              data-clerk-target="signedOut"
            >
              <button
                id="clerk-sign-in"
                type="button"
                data-action="clerk#signIn"
                class="text-indigo-600 hover:text-indigo-800 transition"
              >
                Sign in
              </button>
            </div>

            <div
              id="clerk-signed-in"
              class="hidden flex items-center gap-4"
              data-clerk-target="signedIn"
            >
              <span
                id="clerk-user-name"
                class="text-gray-700"
                data-clerk-target="userName">
              </span>

              <button
                id="clerk-sign-out"
                type="button"
                data-action="clerk#signOut"
                class="text-red-600 hover:text-red-800 transition"
              >
                Sign out
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="mx-auto w-full max-w-7xl px-6 pt-4">
        <% flash.each do |type, message| %>
          <% next if message.blank? %>

          <% alert_classes = type.to_sym == :notice ?
            "border-green-200 bg-green-50 text-green-800" :
            "border-red-200 bg-red-50 text-red-800" %>

          <div
            class="rounded-lg border px-4 py-3 text-sm <%= alert_classes %>"
            role="<%= type.to_sym == :notice ? 'status' : 'alert' %>"
          >
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto px-6 py-10">
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-white">
      <div class="max-w-7xl mx-auto px-6 py-5 text-center text-sm text-gray-500">
        © <%= Date.current.year %> Billetto Events. All rights reserved.
      </div>
    </footer>
  </body>
</html>
